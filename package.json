{
  "name": "@runbotics/winax",
  "version": "3.6.2",
  "description": "Windows COM bindings",
  "homepage": "https://github.com/runbotics/winax",
  "keywords": [
    "OLE",
    "COM",
    "ActiveX",
    "ActiveXObject",
    "CreateObject",
    "Variant",
    "Dispatch",
    "WSH",
    "WMI",
    "Excel",
    "Word",
    "WScript",
    "ConnectObject",
    "DisconnectObject"
  ],
  "author": {
    "name": "Yuri Dursin",
    "url": "https://github.com/durs",
    "email": "yuri.dursin@gmail.com"
  },
  "bin": {
    "nodewscript": "./NodeWScript.js"
  },
  "contributors": [
    "Yuri Dursin <yuri.dursin@gmail.com>",
    "Somanuell",
    "Daniel-Userlane",
    "Alexey Grinevich <alexey.grinevich@inflectra.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/runbotics/winax.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/winax"
  },
  "engines": {
    "node": ">= 10.0.0"
  },
  "scripts": {
    "test": "mocha test",
    "clean": "rimraf prebuilds && mkdir prebuilds",
    "build": "prebuildify --napi --electron-compat && prebuildify --electron-compat --napi false -t 18.12.0 -t 22.11.0 -t 24.12.0 -t 20.9.0 -t electron@33.0.0 -t electron@34.0.0 -t electron@35.0.0 -t electron@36.0.0 -t electron@37.0.0 -t electron@38.0.0 -t electron@39.2.6"
  },
  "gypfile": false,
  "license": "MIT",
  "main": "index.js",
  "os": [
    "win32"
  ],
  "devDependencies": {
    "node-abi": "^4.24.0",
    "prebuildify": "^6.0.1",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "overrides": {
    "prebuildify": {
      "node-abi": "4.24.0"
    }
  }
}
